# ── Python / Backend ──────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg
*.egg-info/
dist/
build/
*.so
.venv/
venv/
env/
ENV/

# Environment & secrets — NEVER commit these
.env
SKOVO_BACKEND/.env
SKOVO_BACKEND/.dev.env
SKOVO_BACKEND/flask_session/
SKOVO_BACKEND/*.log
SKOVO_BACKEND/certs/

# DB files
*.db
*.sqlite3

# ── Node / Frontend ────────────────────────────────────────────────────────────
Skovo/node_modules/
Skovo/dist/
Skovo/.env
Skovo/.env.local
Skovo/.env.production

# ── OS ─────────────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── IDE ─────────────────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo

# ── Claude Code (contains local paths + DB password, never commit) ────────────
.claude/

# ── Uploads ───────────────────────────────────────────────────────────────────
SKOVO_BACKEND/portal/uploads/

# ── PDF / large files ─────────────────────────────────────────────────────────
*.pdf

# ── Dev seed / raw SQL files ──────────────────────────────────────────────────
*.sql
# ...but DO track the versioned schema + stored procedures in the database folder
!SKOVO_BACKEND/database/**/*.sql

# ── Local GitHub clone (downloaded for comparison, not source) ────────────────
SKOVO_GITHUB/

# ── Local dev server logs & scripts (never commit) ────────────────────────────
*.log
srv*.log
run_server.py

# ── Docker secrets (never commit) ─────────────────────────────────────────────
.env.docker
.env.prod
.env.qa
deploy/.env.prod
!deploy/.env.prod.example

# ── Playwright automation (deps, run artifacts, saved auth tokens) ────────────
automation/node_modules/
automation/test-results/
automation/playwright-report/
automation/blob-report/
automation/.auth/

# ── Android build output (regenerated by gradlew, ~450 MB) ────────────────────
SkovoMobile/android/.gradle/
SkovoMobile/android/build/
SkovoMobile/android/app/build/
SkovoMobile/android/.cxx/
SkovoMobile/android/local.properties
*.keystore
!debug.keystore

# ── Keys & certificates — never commit ────────────────────────────────────────
# Added after an SSH private key was handled loosely during a deploy session.
*.pem
*.key
*.p12
*.pfx
*.jks
id_rsa*
*.env.prod
.mcp.json

# Env backups hold the same secrets as .env itself. Without this a file like
# .env.bak.20260828 is untracked-but-stageable, and `git add -A` commits the
# RDS password. No leading slash, so it matches at any depth.
.env.bak*
.env.*.bak

# Editing backups. Git already has the original.
*.jsx.bak
*.js.bak
*.py.bak
*.sql.bak

# JVM crash dumps — written into the repo root by the JDK when a
# java process dies. Never ours, never wanted, 11MB last time.
hs_err_pid*.log
replay_pid*.log
