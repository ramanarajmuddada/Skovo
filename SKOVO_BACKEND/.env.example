# ─────────────────────────────────────────────────────────────────────────────
# SKOVO Environment Variables
# Copy this to .env and fill in real values. Never commit real credentials.
# ─────────────────────────────────────────────────────────────────────────────

# App environment: DEV | UAT | PROD
Backend=DEV

# ── Flask & JWT ───────────────────────────────────────────────────────────────
APP_SECRET_KEY=change-this-to-a-long-random-string-in-production
JWT_SECRET_KEY=change-this-to-a-long-random-jwt-secret-in-production

# ── AES-GCM Encryption ────────────────────────────────────────────────────────
# Generate with: python -c "import os,base64; print(base64.b64encode(os.urandom(32)).decode())"
# Must be a base64-encoded 16, 24, or 32 byte key
ENCRYPTION_KEY=REPLACE_WITH_BASE64_ENCODED_32_BYTE_KEY

# ── Database ──────────────────────────────────────────────────────────────────
# PostgreSQL (default) or MySQL. For MySQL use the pymysql driver, and URL-encode
# any special characters in the password (e.g. '#' becomes '%23'):
#   mysql+pymysql://root:Pass%23123@127.0.0.1:3306/skovo
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/skovo

# ── Cache & Celery (optional) ────────────────────────────────────────────────
# CACHE_TYPE: SimpleCache (default, in-process) or RedisCache for production
CACHE_TYPE=SimpleCache
CACHE_DEFAULT_TIMEOUT=300
# Redis is used as the Flask cache backend (when CACHE_TYPE=RedisCache) and as the
# Celery broker/result backend for background jobs (enrollment emails, reminders).
REDIS_URL=redis://localhost:6379/0

# ── SMS Gateway — MSG91 (primary) ────────────────────────────────────────────
MSG91_AUTH_KEY=your_msg91_auth_key_here
MSG91_SENDER_ID=SKOVO
MSG91_OTP_TEMPLATE_ID=your_msg91_otp_template_id_here

# ── SMS Gateway — Fast2SMS (fallback) ────────────────────────────────────────
FAST2SMS_API_KEY=your_fast2sms_api_key_here

# ── Email ─────────────────────────────────────────────────────────────────────
# Address recipients see on every outgoing mail. Must be a sender/domain that
# is verified with whichever provider actually delivers (SendGrid, SES, Gmail
# "Send mail as" alias) — otherwise it gets rewritten or the mail is rejected.
MAIL_FROM_EMAIL=no-reply@skovoai.com
SENDGRID_API_KEY=
# SMTP fallback, used only when SENDGRID_API_KEY is empty.
# Authenticate as the same mailbox you send from, or the provider rewrites From.
#   Google Workspace  smtp.gmail.com          :587  (app password)
#   Zoho Mail         smtp.zoho.in            :587
#   Amazon SES        email-smtp.<region>.amazonaws.com :587  (SES SMTP creds)
MAILSERVER_DOMAIN=smtp.gmail.com
MAILSERVER_PORT=587
MAILSERVER_USERNAME=no-reply@skovoai.com
MAILSERVER_PASSWORD=your_email_app_password_here
MAIL_SENDER_NAME=SKOVO Team

# ─────────────────────────────────────────────────────────────────────────────
# AWS / PRODUCTION (leave S3_BUCKET empty for local dev → files go to local disk)
# ─────────────────────────────────────────────────────────────────────────────

# ── File uploads → S3 (REQUIRED, including for local development) ────────────
# Prefer an IAM role on the instance/task over static keys.
#
# S3_BUCKET IS NOT OPTIONAL. There is no local-disk fallback: storage.py
# raises StorageError and the upload endpoint answers 503 if the bucket is
# unset, boto3 is missing, or the put fails. Nothing is written anywhere.
#
# This file used to say "leave S3_BUCKET empty for local dev -> files go to
# local disk". That is no longer true. The fallback was removed on purpose:
# identity documents and achievement proofs must live in one auditable place,
# and the old behaviour reported success while quietly putting a government ID
# on whichever instance happened to answer the request.
#
# So a dev box needs real credentials to test uploads at all. Everything else
# in the app works without them - only the upload path fails, and it says so.
S3_BUCKET=skovo-uploads
AWS_REGION=ap-south-1
# The origin that serves /uploads/<name> to a browser - the API, NOT the
# bucket. The bucket blocks public access, so the backend 302s to a
# short-lived presigned URL. Point this at the bucket and every document link
# returns AccessDenied.
S3_PUBLIC_BASE_URL=http://localhost:5000
# S3_ENDPOINT_URL=            # only for S3-compatible services / local testing
#
# Reading someone else's uploads is not required to work on the app. If you do
# not have AWS access, leave S3_BUCKET set anyway - uploads will fail with a
# clear message rather than silently diverging from everyone else's setup.

# ── CORS — lock to your frontend origin(s) in prod (comma-separated) ─────────
# Default "*" is for dev only.
CORS_ORIGINS=*

# ── Server-side sessions — use redis behind a load balancer ──────────────────
# SESSION_TYPE=redis
# SESSION_REDIS=redis://your-elasticache-endpoint:6379/1

# ── Scheduler & migrations (multi-instance coordination) ─────────────────────
# Web tasks: ENABLE_SCHEDULER=0 and RUN_MIGRATIONS=0.
# One dedicated scheduler task: ENABLE_SCHEDULER=1 (runs run_scheduler.py).
# One dedicated pre-deploy task: RUN_MIGRATIONS=1 (runs `flask db upgrade`).
ENABLE_SCHEDULER=1
RUN_MIGRATIONS=1

# ---------------------------------------------------------------- Cashfree
# sandbox | production -- picks both the endpoint and which key pair below is
# used, so both environments live here at once and switching is this one line.
# Local and staging run on sandbox; only a deployed production host sets
# production, and that account must be activated by Cashfree first (an
# unactivated one returns "transactions are not enabled for your account").
CASHFREE_ENV=sandbox

# Cashfree dashboard > Developers > API Keys, in the matching environment.
CASHFREE_APP_ID_SANDBOX=
CASHFREE_SECRET_KEY_SANDBOX=
CASHFREE_APP_ID_PRODUCTION=
CASHFREE_SECRET_KEY_PRODUCTION=

# Optional. Cashfree signs webhooks with the client secret, so leaving these
# empty falls back to the secret above; set one only to rotate it separately.
CASHFREE_WEBHOOK_SECRET_SANDBOX=
CASHFREE_WEBHOOK_SECRET_PRODUCTION=

# Cashfree Payouts — Admin Pay credits the achiever's bank/UPI. Falls back to
# the payment-gateway pair above when unset. Fund source is the SKOVO balance
# in the Payouts dashboard; set only if that account has more than one.
CASHFREE_PAYOUT_CLIENT_ID_SANDBOX=
CASHFREE_PAYOUT_CLIENT_SECRET_SANDBOX=
CASHFREE_PAYOUT_CLIENT_ID_PRODUCTION=
CASHFREE_PAYOUT_CLIENT_SECRET_PRODUCTION=
CASHFREE_PAYOUT_FUNDSOURCE_ID=

# ── BhaAI (grounded career chat) ─────────────────────────────────────────────
# Any provider that speaks the OpenAI-style chat-completions format. Leave the
# key empty and BhaAI stays off (the page says so; nothing breaks).
#   OpenAI      https://api.openai.com/v1                              gpt-4o-mini
#   Groq        https://api.groq.com/openai/v1                         llama-3.1-8b-instant
#   Gemini      https://generativelanguage.googleapis.com/v1beta/openai gemini-2.0-flash
#   OpenRouter  https://openrouter.ai/api/v1                           (any listed model)
BHAAI_LLM_BASE_URL=https://api.openai.com/v1
BHAAI_LLM_API_KEY=
BHAAI_LLM_MODEL=gpt-4o-mini
# Some newer models want max_completion_tokens instead of max_tokens.
BHAAI_LLM_MAX_TOKENS_PARAM=max_tokens
BHAAI_LLM_TIMEOUT=25
# Questions per day (IST). Free 0 keeps BhaAI a Pro perk with a teaser for free.
BHAAI_PRO_DAILY=10
BHAAI_FREE_DAILY=0
