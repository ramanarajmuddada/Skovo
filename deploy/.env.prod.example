# ═══════════════════════════════════════════════════════════════════════════════
# SKOVO — production environment
#
#   cp deploy/.env.prod.example deploy/.env.prod   (on the EC2 host, chmod 600)
#
# deploy/.env.prod is gitignored and must NEVER be committed. It is the only
# place real credentials exist on the host.
# ═══════════════════════════════════════════════════════════════════════════════

# ── Image (set by CI; only needed for manual `docker compose up`) ─────────────
ECR_IMAGE=123456789012.dkr.ecr.ap-south-1.amazonaws.com/skovo-backend:latest

# ── Domains ───────────────────────────────────────────────────────────────────
API_DOMAIN=api.skovoai.com
GRAFANA_DOMAIN=metrics.skovoai.com
ACME_EMAIL=ops@skovoai.com

# ── Database — RDS MySQL ──────────────────────────────────────────────────────
# MUST be mysql+pymysql. A Postgres URL connects successfully and then fails on
# the first stored-procedure CALL, which makes it look like an app bug.
# URL-encode special characters in the password ('#' → '%23').
DATABASE_URL=mysql+pymysql://skovo:CHANGE_ME@skovo-db.abcdefg.ap-south-1.rds.amazonaws.com:3306/skovo?charset=utf8mb4

# ── Flask secrets ─────────────────────────────────────────────────────────────
# python -c "import secrets; print(secrets.token_urlsafe(64))"
APP_SECRET_KEY=CHANGE_ME
JWT_SECRET_KEY=CHANGE_ME
# python -c "import os,base64; print(base64.b64encode(os.urandom(32)).decode())"
ENCRYPTION_KEY=CHANGE_ME

# ── S3 uploads ────────────────────────────────────────────────────────────────
S3_BUCKET=skovo-uploads
AWS_REGION=ap-south-1
# Public URL prefix for stored objects — the CloudFront domain in front of the
# bucket. Leave blank to fall back to the raw S3 URL.
S3_PUBLIC_BASE_URL=https://cdn.skovoai.com

# ── Domains ───────────────────────────────────────────────────────────────────
# All three must already resolve to this instance before Caddy starts, or the
# Let's Encrypt challenge fails and Caddy retries on a backoff.
# Students + achievers.
WEB_DOMAIN=skovoai.com
# Admin + super-admin portals, on their own registrable domain. Requests to the
# portal paths on WEB_DOMAIN are redirected here; everything else is served on
# both.
#
# This value is ALSO baked into the frontend image (as VITE_ADMIN_HOST, see
# docker-compose.prod.yml). It is what makes this domain's root render the admin
# landing page instead of the student one, so it must match the hostname
# browsers actually use — not a CNAME or alias of it.
ADMIN_DOMAIN=skovoai.info
API_DOMAIN=api.skovoai.com
GRAFANA_DOMAIN=metrics.skovoai.com
ACME_EMAIL=ops@skovoai.com

# ── Frontend build ────────────────────────────────────────────────────────────
# Hostname only, no scheme — api.js builds `https://${VITE_API_HOST}/v1`.
# Vite inlines this at BUILD time, so changing it means rebuilding the image,
# not restarting the container. Leave it unset and the whiteboard's Socket.IO
# client falls back to http://127.0.0.1:5000 and never connects.
VITE_API_HOST=api.skovoai.com

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated. Never "*" in production: the whiteboard socket authenticates
# with a JWT, so a wildcard lets any site open an authenticated connection.
#
# The admin domain is a SEPARATE origin from the web domain — every /v1 call the
# admin and super-admin portals make is cross-origin. Omit it and the portals
# render fine and then fail on the first request, which reads as "login is
# broken" rather than as a CORS problem.
CORS_ORIGINS=https://skovoai.com,https://www.skovoai.com,https://skovoai.info

# ── Gunicorn ──────────────────────────────────────────────────────────────────
# Keep the worker class as eventlet — Socket.IO cannot run on sync workers.
GUNICORN_WORKERS=3

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_MAXMEMORY=512mb

# ── Grafana ───────────────────────────────────────────────────────────────────
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME

# ── Payments ──────────────────────────────────────────────────────────────────
RAZORPAY_KEY_ID=
RAZORPAY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ── SMS ───────────────────────────────────────────────────────────────────────
MSG91_AUTH_KEY=
MSG91_SENDER_ID=SKOVO
MSG91_OTP_TEMPLATE_ID=
FAST2SMS_API_KEY=

# ── Mail ──────────────────────────────────────────────────────────────────────
MAILSERVER_DOMAIN=smtp.gmail.com
MAILSERVER_PORT=587
MAILSERVER_USERNAME=
MAILSERVER_PASSWORD=
MAIL_SENDER_NAME=SKOVO Team

LOG_LEVEL=info

# ══════════════════════════════════════════════════════════════════════════════
# The block below was added after an audit found 26 variables that the code
# reads via os.environ.get() but that appeared in neither this file nor
# docker-compose.prod.yml. None of them crash the app when missing — every one
# degrades silently, which is worse. Set them or knowingly leave them blank.
# ══════════════════════════════════════════════════════════════════════════════

# ── Mail delivery (SendGrid) ──────────────────────────────────────────────────
# Without SENDGRID_API_KEY there is no signup OTP, no password reset and no
# booking notification. MAILSERVER_* above is only the SMTP fallback.
SENDGRID_API_KEY=
MAIL_FROM_EMAIL=no-reply@skovoai.com

# ── Public site URL ───────────────────────────────────────────────────────────
# Every link inside an outgoing email is built from this. Wrong value = every
# verification and reset link in every email points somewhere that isn't you.
FRONTEND_BASE_URL=https://skovoai.com

# ── Background verification webhook ───────────────────────────────────────────
# The BGV vendor signs its callback with this. Unset, the endpoint rejects
# every callback (fails closed, by design) and no achiever is ever cleared to
# tier L3 — so no achiever can teach a 14-17 year old student.
BGV_WEBHOOK_SECRET=

# ── Video sessions (Daily.co) ─────────────────────────────────────────────────
# Unset, no room is auto-created; sessions show a Join link only once one is
# supplied by the achiever/admin.
DAILY_API_KEY=
DAILY_SUBDOMAIN=
DAILY_PRIVATE=1
DAILY_ENABLE_RECORDING=0

# ── WhatsApp / SMS notifications (MSG91) ──────────────────────────────────────
# The OTP path uses MSG91_AUTH_KEY above; these drive the notification path,
# which is off unless explicitly enabled.
NOTIFY_SMS_ENABLED=0
NOTIFY_WHATSAPP_ENABLED=0
MSG91_SMS_SENDER=SKOVO
MSG91_WA_NUMBER=
MSG91_WA_NAMESPACE=
WHATSAPP_NOTIFY_TEMPLATE=

# ── CRM lead sync (Zoho) ──────────────────────────────────────────────────────
ZOHO_WEBHOOK_URL=

# ── Payments ──────────────────────────────────────────────────────────────────
# Razorpay Route splits an achiever's share at capture time. Leave 0 until the
# linked accounts exist, or captures fail.
RAZORPAY_ROUTE_ENABLED=0

# ── Caching / rate limiting ───────────────────────────────────────────────────
# docker-compose.prod.yml already sets REDIS_URL, SESSION_TYPE and CACHE_TYPE
# for the containers. These are here for a non-compose deploy (ECS, EB, bare EC2)
# where nothing else supplies them.
REDIS_URL=redis://redis:6379/0
CACHE_TYPE=RedisCache
CACHE_DEFAULT_TIMEOUT=300
RATELIMIT_STORAGE_URI=redis://redis:6379/2
# 'filesystem' is per-instance local disk. Behind a load balancer set redis so
# the session store is shared. Auth is JWT, so the blast radius is small.
SESSION_TYPE=redis
SESSION_REDIS=redis://redis:6379/1

# ── Scheduler ─────────────────────────────────────────────────────────────────
# MUST be 0 on every web task. The reminder/lifecycle jobs run in exactly one
# place: the dedicated `python run_scheduler.py` service. Set it to 1 on more
# than one process and students get duplicate reminder emails.
ENABLE_SCHEDULER=0

# ── Database bootstrap ────────────────────────────────────────────────────────
# Passed straight to apply_all.py by entrypoint.sh. Use --baseline on the FIRST
# deploy against a database that already has the 53 migrations applied; leave
# blank for a fresh database.
APPLY_ALL_ARGS=
